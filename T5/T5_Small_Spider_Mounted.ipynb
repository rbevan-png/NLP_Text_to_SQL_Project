    {
      "source": [
        "model = AutoModelForSeq2SeqLM.from_pretrained(\"finetuned_model_2_epoch\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(\"t5-small\")\n",
        "\n",
        "def preprocess_spider(example):\n",
        "    prompt = f\"Question:\\n{example['question']}\\n\\nAnswer:\\n\"\n",
        "    inputs = tokenizer(prompt, padding=\"max_length\", truncation=True, return_tensors=\"pt\")\n",
        "    labels = tokenizer(example['query'], padding=\"max_length\", truncation=True, return_tensors=\"pt\")\n",
        "    return {\n",
        "        'input_ids': inputs.input_ids[0],\n",
        "        'attention_mask': inputs.attention_mask[0],\n",
        "        'labels': labels.input_ids[0]\n",
        "    }\n",
        "\n",
        "tokenized_spider = spider.map(preprocess_spider, batched=False)\n",
        "tokenized_spider.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"./finetuned_model_spider\",\n",
        "\n",
        "    learning_rate=5e-4,\n",
        "    per_device_train_batch_size=8,\n",
        "    per_device_eval_batch_size=8,\n",
        "    num_train_epochs=3,\n",
        "    weight_decay=0.01,\n",
        "    save_total_limit=2,\n",
        "    fp16=torch.cuda.is_available(),\n",
        ")\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized_spider[\"train\"],\n",
        "    eval_dataset=tokenized_spider[\"validation\"],\n",
        "    tokenizer=tokenizer,\n",
        ")\n",
        "\n",
        "trainer.train()\n",
        "\n",
        "trainer.save_model(\"./finetuned_model_spider\")"
      ],
