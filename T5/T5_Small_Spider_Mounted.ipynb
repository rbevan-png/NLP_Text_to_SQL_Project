        "import sqlite3\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "def setup_database(context_text):\n",
        "    conn = sqlite3.connect(':memory:')\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    commands = context_text.strip().split(';')\n",
        "    for command in commands:\n",
        "        if command.strip():\n",
        "            try:\n",
        "                cursor.execute(command)\n",
        "            except Exception as e:\n",
        "                print(f\"Failed to execute command: {command}\\nError: {e}\")\n",
        "    conn.commit()\n",
        "    return conn\n",
        "\n",
        "\n",
        "def execute_query(conn, query):\n",
        "    try:\n",
        "        cursor = conn.cursor()\n",
        "        cursor.execute(query)\n",
        "        result = cursor.fetchall()\n",
        "\n",
        "        result = sorted(result)\n",
        "        return result\n",
        "    except Exception as e:\n",
        "        print(f\"Query Execution Failed: {query}\\nError: {e}\")\n",
        "        return None\n",
        "\n",
        "def compute_exact_match_accuracy(ground_truth_sqls, model_sqls):\n",
        "    correct = 0\n",
        "    total = len(ground_truth_sqls)\n",
        "\n",
        "    for gt_sql, model_sql in zip(ground_truth_sqls, model_sqls):\n",
        "        if gt_sql.strip() == model_sql.strip():\n",
        "            correct += 1\n",
        "\n",
        "    accuracy = correct / total\n",
        "    print(f\"Exact Match Accuracy: {accuracy:.4f} ({correct}/{total})\")\n",
        "    return accuracy\n",
        "\n",
        "\n",
        "def compute_execution_accuracy(contexts, ground_truth_sqls, model_sqls):\n",
        "    correct = 0\n",
        "    total = len(contexts)\n",
        "\n",
        "    for idx in range(total):\n",
        "        context = contexts[idx]\n",
        "        gt_sql = ground_truth_sqls[idx]\n",
        "        model_sql = model_sqls[idx]\n",
        "\n",
        "        conn = setup_database(context)\n",
        "\n",
        "        gt_result = execute_query(conn, gt_sql)\n",
        "        model_result = execute_query(conn, model_sql)\n",
        "\n",
        "        conn.close()\n",
        "\n",
        "        if gt_result is not None and model_result is not None and gt_result == model_result:\n",
        "            correct += 1\n",
        "\n",
        "    accuracy = correct / total\n",
        "    print(f\"Execution Match Accuracy: {accuracy:.4f} ({correct}/{total})\")\n",
        "    return accuracy"
      ]
    },
