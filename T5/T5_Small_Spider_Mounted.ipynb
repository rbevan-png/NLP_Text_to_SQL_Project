      "cell_type": "code",
      "source": [
        "model = AutoModelForSeq2SeqLM.from_pretrained(\"./finetuned_model_spider\").to(\"cuda\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(\"t5-small\")\n",
        "\n",
        "spider = load_dataset(\"spider\")\n",
        "contexts = spider['validation']['db_id']\n",
        "questions = spider['validation']['question']\n",
        "ground_truth_sqls = spider['validation']['query']\n",
        "\n",
        "model_outputs = []\n",
        "for idx in range(len(questions)):\n",
        "    prompt = f\"Question:\\n{questions[idx]}\\n\\nAnswer:\\n\"\n",
        "    input_ids = tokenizer(prompt, return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
        "\n",
        "    output_ids = model.generate(input_ids=input_ids, generation_config=GenerationConfig(max_new_tokens=300))\n",
        "    output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)\n",
        "\n",
        "    model_outputs.append(output_text)\n"
      ],
      "metadata": {
        "id": "0N_vZKymplRO"
      },
      "id": "0N_vZKymplRO",
